#!/usr/bin/env sh
# pre-push: las fronteras de dependencia se respetan, el proyecto compila sin
# advertencias y pasa las pruebas antes de publicar. Usa las mismas banderas en
# ambos comandos de cabal para que no recompile entre uno y otro.
# No se omite con --no-verify.
set -eu

root=$(git rev-parse --show-toplevel)
PATH="$HOME/.ghcup/bin:$PATH"

command -v cabal >/dev/null 2>&1 || {
  echo "Falta cabal. Instala GHC 9.6.7 y cabal con ghcup." >&2
  exit 1
}

cd "$root"
sh scripts/check-boundaries.sh
cabal build all --ghc-options=-Werror
cabal test all --ghc-options=-Werror
