cabal-version:      3.0
name:               solpus-core
version:            0.1.0.0
synopsis:           Dominio puro de Solpus (sin IO)
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           warnings
  exposed-modules:  Solpus.Core.Base58
                    Solpus.Core.Error
                    Solpus.Core.Lamports
                    Solpus.Core.Types
                    Solpus.Core.Validate
                    Solpus.Core.Version
  build-depends:    base        >=4.18 && <4.19
                  , bytestring  >=0.11 && <0.12
                  , text        >=2.0  && <2.1
  hs-source-dirs:   src
  default-language: GHC2021

test-suite unit
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  other-modules:    Test.Base58
                    Test.Lamports
                    Test.Validate
  hs-source-dirs:   test
  default-language: GHC2021
  build-depends:    base            >=4.18 && <4.19
                  , bytestring      >=0.11 && <0.12
                  , text            >=2.0  && <2.1
                  , hedgehog
                  , solpus-core
                  , tasty
                  , tasty-hedgehog
                  , tasty-hunit
