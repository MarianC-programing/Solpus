cabal-version:      3.0
name:               solpus-client
version:            0.1.0.0
synopsis:           Frontera de Solpus con la red y con solana-haskell-sdk
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           warnings
  exposed-modules:  Solpus.Client.Class
                    Solpus.Client.Config
                    Solpus.Client.InMemory
                    Solpus.Client.Info
                    Solpus.Client.Rpc
                    Solpus.Client.Tx
                    Solpus.Client.Wallet
  build-depends:    base                >=4.18 && <4.19
                  , bytestring          >=0.11 && <0.12
                  , containers          >=0.6  && <0.7
                  , http-client
                  , http-client-tls
                  , http-types
                  , jsonrpc-tinyclient  >=1.1  && <1.2
                  , solana-haskell-sdk  ==1.4.0.0
                  , text                >=2.0  && <2.1
                  , transformers        >=0.6  && <0.7
                  , unix                >=2.8  && <2.9
                  , web3-provider       >=1.1  && <1.2
                  , solpus-core
  hs-source-dirs:   src
  default-language: GHC2021

test-suite unit
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  other-modules:    Test.Config
                    Test.InMemory
                    Test.Rpc
                    Test.Transfer
                    Test.Wallet
  hs-source-dirs:   test
  default-language: GHC2021
  build-depends:    base                >=4.18 && <4.19
                  , bytestring          >=0.11 && <0.12
                  , directory
                  , ed25519
                  , filepath
                  , hedgehog
                  , http-client
                  , jsonrpc-tinyclient  >=1.1  && <1.2
                  , network
                  , solana-haskell-sdk  ==1.4.0.0
                  , solpus-client
                  , solpus-core
                  , tasty
                  , tasty-hedgehog
                  , tasty-hunit
                  , text                >=2.0  && <2.1
                  , unix                >=2.8  && <2.9
                  , web3-provider       >=1.1  && <1.2

-- Contra solana-test-validator; se omite salvo con SOLANA_INTEGRATION=1.
test-suite integration
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test-integration
  default-language: GHC2021
  build-depends:    base                >=4.18 && <4.19
                  , bytestring          >=0.11 && <0.12
                  , directory
                  , filepath
                  , process
                  , solana-haskell-sdk  ==1.4.0.0
                  , solpus-client
                  , solpus-core
                  , tasty
                  , tasty-hunit
                  , text                >=2.0  && <2.1
                  , time
                  , unix                >=2.8  && <2.9
                  , web3-provider       >=1.1  && <1.2
                  , websockets
