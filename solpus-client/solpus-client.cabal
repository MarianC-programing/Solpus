cabal-version:      3.0
name:               solpus-client
version:            0.1.0.0
synopsis:           Frontera de Solpus con la red y con solana-haskell-sdk
build-type:         Simple

common warnings
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           warnings
  exposed-modules:  Solpus.Client.Info
  build-depends:    base         >=4.18 && <4.19
                  , text         >=2.0  && <2.1
                  , solpus-core
  hs-source-dirs:   src
  default-language: GHC2021
